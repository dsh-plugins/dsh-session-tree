{
  "name": "@dsh-plugin/dsh-session-tree",
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "repository": { "type": "git", "url": "git+https://github.com/dsh-plugins/dsh-session-tree.git" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "description": "支持分支切换、编辑、撤回和重试的 DSH 树状会话插件。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "docs", "locale", "icon.svg", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc && tsdown --config tsdown.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.1 || 0.2.2-rc.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@dsh-plugin/dsh-loader"], "platform": "web" }
  },
  "peerDependencies": { "@dsh-plugin/dsh-loader": "^2.0.0-dev.43473963317" },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.43473963317",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
